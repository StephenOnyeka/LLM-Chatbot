# Base URL for the backend API (must include the /api suffix).
# Local dev: leave unset to use the Vite proxy (defaults to /api).
# Production: point at the deployed backend, e.g. the Render URL below.
VITE_API_BASE=https://ajci-backend.onrender.com/api

# Google OAuth Web client ID (same value as the backend's GOOGLE_CLIENT_ID).
# Create one at https://console.cloud.google.com/apis/credentials and add your
# frontend origin (e.g. http://localhost:5173) to authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=800714930204-ldmvvdtua0iq0r0mao8avi6bonsnqvtp.apps.googleusercontent.com
