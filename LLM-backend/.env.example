RATE_LIMIT_AUTH_PER_MINUTE=10

# Stripe (Pro Plan Subscription Integration)
# Get your API keys at https://dashboard.stripe.com/test/apikeys
# - STRIPE_SECRET_KEY: Use your test mode secret key (starts with sk_test_...) or a restricted key (rk_test_...) with write access to Checkout Sessions, Customers, and Subscriptions.
STRIPE_SECRET_KEY=

# - STRIPE_WEBHOOK_SECRET (Optional for local development):
#   Only needed if you want real-time webhook listening. If left blank, instant upgrade is still handled via redirect verification.
#   Retrieve by running `stripe listen --forward-to localhost:4000/api/stripe/webhook` or via Dashboard -> Developers -> Webhooks.
STRIPE_WEBHOOK_SECRET=

# - STRIPE_PRICE_ID (Optional):
#   Pre-configured Price ID from Stripe dashboard. If left blank, the backend automatically generates a $10/mo inline pricing item.
STRIPE_PRICE_ID=

# --- Stripe Test mode payment credentials ---
# Card Number: 4242 4242 4242 4242
# Expiry Date: Any future date (e.g., 12/28)
# CVC: Any 3 digits (e.g., 123)
# Name/Zip: Any value

